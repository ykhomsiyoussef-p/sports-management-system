# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file.

PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/sports_management
SESSION_SECRET=change_this_to_a_long_random_string

# Admin account created by "npm run seed". Change these before seeding
# a production database, then log in and change the password if needed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
