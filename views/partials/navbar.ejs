<nav class="bg-slate-900 text-white shadow-md">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <a href="/dashboard" class="flex items-center gap-2 font-bold text-lg tracking-tight">
        <span>🏆</span>
        <span>Sports Management</span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-1">
        <a href="/dashboard" class="nav-link <%= currentPath === '/dashboard' ? 'nav-link-active' : '' %>">Dashboard</a>
        <a href="/teams" class="nav-link <%= currentPath.startsWith('/teams') ? 'nav-link-active' : '' %>">Teams</a>
        <a href="/players" class="nav-link <%= currentPath.startsWith('/players') ? 'nav-link-active' : '' %>">Players</a>
        <a href="/coaches" class="nav-link <%= currentPath.startsWith('/coaches') ? 'nav-link-active' : '' %>">Coaches</a>
        <a href="/games" class="nav-link <%= currentPath.startsWith('/games') ? 'nav-link-active' : '' %>">Games</a>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <span class="nav-user-badge">
            <%= currentUser.username %>
            <span class="badge <%= currentUser.role === 'admin' ? 'badge-admin' : 'badge-viewer' %>"><%= currentUser.role %></span>
          </span>
          <form action="/logout" method="POST" class="inline">
            <button type="submit" class="nav-link">Log Out</button>
          </form>
        <% } %>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 rounded hover:bg-slate-800" aria-label="Toggle menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile dropdown menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4 space-y-1">
      <a href="/dashboard" class="nav-link-mobile">Dashboard</a>
      <a href="/teams" class="nav-link-mobile">Teams</a>
      <a href="/players" class="nav-link-mobile">Players</a>
      <a href="/coaches" class="nav-link-mobile">Coaches</a>
      <a href="/games" class="nav-link-mobile">Games</a>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <div class="nav-link-mobile text-slate-400">
          Logged in as <%= currentUser.username %> (<%= currentUser.role %>)
        </div>
        <form action="/logout" method="POST">
          <button type="submit" class="nav-link-mobile w-full text-left">Log Out</button>
        </form>
      <% } %>
    </div>
  </div>
</nav>
