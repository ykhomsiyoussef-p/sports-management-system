<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/messages') %>

<main class="flex-1 max-w-xl mx-auto w-full px-4 py-8">
  <h1 class="text-2xl font-bold mb-6"><%= title %></h1>

  <form action="<%= formAction %>" method="POST" class="card space-y-4">
    <div>
      <label class="label">Full Name *</label>
      <input type="text" name="name" value="<%= player.name || '' %>" required class="input" />
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="label">Position *</label>
        <select name="position" required class="input">
          <option value="">-- Select --</option>
          <% positions.forEach(function(pos) { %>
            <option value="<%= pos %>" <%= player.position === pos ? 'selected' : '' %>><%= pos %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="label">Jersey Number *</label>
        <input type="number" name="jerseyNumber" value="<%= player.jerseyNumber || '' %>" min="1" max="99" required class="input" />
      </div>
    </div>

    <div>
      <label class="label">Nationality *</label>
      <input type="text" name="nationality" value="<%= player.nationality || '' %>" required class="input" />
    </div>

    <div>
      <label class="label">Date of Birth *</label>
      <input type="date" name="dateOfBirth" value="<%= player.dateOfBirth ? new Date(player.dateOfBirth).toISOString().slice(0,10) : '' %>" required class="input" />
    </div>

    <div>
      <label class="label">Team *</label>
      <select name="team" required class="input">
        <option value="">-- Select Team --</option>
        <% teams.forEach(function(t) { %>
          <option value="<%= t._id %>" <%= (player.team && String(player.team) === String(t._id)) ? 'selected' : '' %>>
            <%= t.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="label">Goals</label>
        <input type="number" name="goals" value="<%= player.goals || 0 %>" min="0" class="input" />
      </div>
      <div>
        <label class="label">Rating (1-5)</label>
        <input type="number" name="rating" value="<%= player.rating || 3 %>" min="1" max="5" class="input" />
      </div>
    </div>

    <div>
      <label class="label">Photo URL</label>
      <input type="text" name="photoUrl" value="<%= player.photoUrl || '' %>" placeholder="https://..." class="input" />
    </div>

    <div class="flex gap-2 pt-2">
      <button type="submit" class="btn-primary">Save Player</button>
      <a href="/players" class="btn-secondary">Cancel</a>
    </div>
  </form>
</main>

<%- include('../partials/footer') %>
