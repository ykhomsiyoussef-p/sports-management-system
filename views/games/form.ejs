<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/messages') %>

<main class="flex-1 max-w-xl mx-auto w-full px-4 py-8">
  <h1 class="text-2xl font-bold mb-6"><%= title %></h1>

  <form action="<%= formAction %>" method="POST" class="card space-y-4">
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="label">Home Team *</label>
        <select name="homeTeam" required class="input">
          <option value="">-- Select --</option>
          <% teams.forEach(function(t) { %>
            <option value="<%= t._id %>" <%= (game.homeTeam && String(game.homeTeam) === String(t._id)) ? 'selected' : '' %>>
              <%= t.name %>
            </option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="label">Away Team *</label>
        <select name="awayTeam" required class="input">
          <option value="">-- Select --</option>
          <% teams.forEach(function(t) { %>
            <option value="<%= t._id %>" <%= (game.awayTeam && String(game.awayTeam) === String(t._id)) ? 'selected' : '' %>>
              <%= t.name %>
            </option>
          <% }) %>
        </select>
      </div>
    </div>

    <div>
      <label class="label">Date &amp; Time *</label>
      <input
        type="datetime-local" name="date" required class="input"
        value="<%= game.date ? new Date(game.date).toISOString().slice(0,16) : '' %>"
      />
    </div>

    <div>
      <label class="label">Stadium *</label>
      <input type="text" name="stadium" value="<%= game.stadium || '' %>" required class="input" />
    </div>

    <div class="grid grid-cols-3 gap-4">
      <div>
        <label class="label">Status</label>
        <select name="status" class="input">
          <% statuses.forEach(function(s) { %>
            <option value="<%= s %>" <%= game.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="label">Home Score</label>
        <input type="number" name="homeScore" value="<%= game.homeScore || 0 %>" min="0" class="input" />
      </div>
      <div>
        <label class="label">Away Score</label>
        <input type="number" name="awayScore" value="<%= game.awayScore || 0 %>" min="0" class="input" />
      </div>
    </div>

    <div>
      <label class="label">Lineup</label>
      <% if (players.length) { %>
        <div class="grid grid-cols-2 gap-2 max-h-56 overflow-y-auto border rounded p-3">
          <% players.forEach(function(p) { %>
            <label class="flex items-center gap-2 text-sm">
              <input
                type="checkbox" name="players" value="<%= p._id %>"
                <%= (game.players && game.players.map(String).includes(String(p._id))) ? 'checked' : '' %>
              />
              #<%= p.jerseyNumber %> <%= p.name %> <span class="text-slate-400">(<%= p.team ? p.team.name : '' %>)</span>
            </label>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-sm text-slate-400 border rounded p-3">
          Save the game first, then edit it to pick a lineup from the two teams' rosters.
        </p>
      <% } %>
    </div>

    <div class="flex gap-2 pt-2">
      <button type="submit" class="btn-primary">Save Game</button>
      <a href="/games" class="btn-secondary">Cancel</a>
    </div>
  </form>
</main>

<%- include('../partials/footer') %>
