<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/messages') %>

<main class="flex-1 max-w-6xl mx-auto w-full px-4 py-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <h1 class="text-2xl font-bold">👔 Coaches</h1>
    <a href="/coaches/new" class="btn-primary">+ Add Coach</a>
  </div>

  <form method="GET" action="/coaches" class="mb-6">
    <input
      type="text" name="search" value="<%= search %>"
      placeholder="Search coaches by name..."
      class="input w-full sm:w-80"
    />
  </form>

  <div class="card p-0 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-slate-500">
        <tr>
          <th class="px-4 py-3">Name</th>
          <th class="px-4 py-3">Nationality</th>
          <th class="px-4 py-3">Experience</th>
          <th class="px-4 py-3">Team</th>
          <th class="px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        <% coaches.forEach(function(c) { %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-medium"><%= c.name %></td>
            <td class="px-4 py-3"><%= c.nationality %></td>
            <td class="px-4 py-3"><%= c.experienceYears %> yrs</td>
            <td class="px-4 py-3"><%= c.team ? c.team.name : '—' %></td>
            <td class="px-4 py-3 text-right space-x-2">
              <a href="/coaches/<%= c._id %>/edit" class="link">Edit</a>
              <form action="/coaches/<%= c._id %>?_method=DELETE" method="POST" class="inline confirm-delete" data-name="<%= c.name %>">
                <button type="submit" class="link-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (!coaches.length) { %>
          <tr><td colspan="5" class="px-4 py-8 text-center text-slate-400">No coaches found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <%- include('../partials/pagination', { basePath: '/coaches', page, totalPages, extraQuery: search ? ('&search=' + encodeURIComponent(search)) : '' }) %>
</main>

<%- include('../partials/footer') %>
